/* Theme Variables System */
:root, [data-theme="dark"] {
  --bg-primary: #0f172a; /* Slate 900 */
  --bg-secondary: #1e293b; /* Slate 800 */
  --text-primary: #f8fafc; /* Slate 50 */
  --text-secondary: #94a3b8; /* Slate 400 */
  --accent-primary: #3b82f6; /* Blue 500 */
  --accent-hover: #2563eb;
  --accent-success: #10b981;
  --accent-warning: #f59e0b;
  --accent-danger: #ef4444;
  --glass-bg: rgba(30, 41, 59, 0.75);
  --glass-border: rgba(255, 255, 255, 0.1);
  --card-bg: rgba(30, 41, 59, 0.75);
  --table-header-bg: #18181b;
  --input-bg: rgba(255, 255, 255, 0.06);
  --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

[data-theme="light"] {
  --bg-primary: #f1f5f9; /* Slate 100 */
  --bg-secondary: #ffffff; /* White */
  --text-primary: #0f172a; /* Dark Slate */
  --text-secondary: #475569; /* Slate 600 */
  --accent-primary: #2563eb; /* Royal Blue */
  --accent-hover: #1d4ed8;
  --accent-success: #059669;
  --accent-warning: #d97706;
  --accent-danger: #dc2626;
  --glass-bg: rgba(255, 255, 255, 0.88);
  --glass-border: rgba(148, 163, 184, 0.3);
  --card-bg: rgba(255, 255, 255, 0.88);
  --table-header-bg: #e2e8f0;
  --input-bg: rgba(15, 23, 42, 0.05);
}

[data-theme="corporate"] {
  --bg-primary: #031b4e; /* Deep Navy Hanei */
  --bg-secondary: #0a2e7a;
  --text-primary: #f0f6ff;
  --text-secondary: #93c5fd;
  --accent-primary: #38bdf8; /* Cyan Glow */
  --accent-hover: #0284c7;
  --accent-success: #34d399;
  --accent-warning: #fbbf24;
  --accent-danger: #f87171;
  --glass-bg: rgba(10, 46, 122, 0.75);
  --glass-border: rgba(56, 189, 248, 0.22);
  --card-bg: rgba(10, 46, 122, 0.75);
  --table-header-bg: #02143b;
  --input-bg: rgba(255, 255, 255, 0.08);
}

[data-theme="emerald"] {
  --bg-primary: #04201a; /* Deep Emerald */
  --bg-secondary: #0a3a30;
  --text-primary: #ecfdf5;
  --text-secondary: #6ee7b7;
  --accent-primary: #10b981;
  --accent-hover: #059669;
  --accent-success: #34d399;
  --accent-warning: #f59e0b;
  --accent-danger: #f87171;
  --glass-bg: rgba(10, 58, 48, 0.78);
  --glass-border: rgba(16, 185, 129, 0.22);
  --card-bg: rgba(10, 58, 48, 0.78);
  --table-header-bg: #021612;
  --input-bg: rgba(255, 255, 255, 0.08);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: var(--font-family);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  line-height: 1.4;
  transition: background-color 0.3s ease, color 0.3s ease;
}

a {
  color: var(--accent-primary);
  text-decoration: none;
  transition: color 0.2s ease;
}

a:hover {
  color: var(--accent-hover);
}

/* Glassmorphism Utilities */
.glass-panel {
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  border-radius: 14px;
  padding: 18px 22px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  color: var(--text-primary);
  transition: background 0.3s ease, border-color 0.3s ease;
}

/* Layout Utilities - Space-Optimized Container */
.container {
  max-width: 96%;
  margin: 0 auto;
  padding: 1rem 1.25rem;
}

.grid-dashboard {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1.25rem;
}

/* Typography Utilities */
h1, h2, h3, h4 {
  font-weight: 700;
  line-height: 1.25;
  margin-bottom: 0.35rem;
  color: var(--text-primary);
}

.text-sub {
  color: var(--text-secondary);
  font-size: 0.8rem;
}

.metric-value {
  font-size: 1.75rem;
  font-weight: 700;
  margin: 0.35rem 0;
  color: var(--text-primary);
}

/* Status colors */
.text-success { color: var(--accent-success); }
.text-danger { color: var(--accent-danger); }
.text-warning { color: var(--accent-warning); }

/* Card Hover & Interactive Effects */
.module-card {
  background: var(--card-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  padding: 1.35rem 1.5rem;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
}

.module-card:hover {
  transform: translateY(-4px);
  border-color: var(--accent-primary);
  box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.3), 0 0 16px var(--glass-border);
}

.module-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: var(--card-accent, linear-gradient(90deg, #3b82f6, #60a5fa));
  opacity: 0.85;
  transition: opacity 0.3s ease;
}

.module-card:hover::before {
  opacity: 1;
}

/* Logo Container */
.logo-container {
  background: #ffffff;
  padding: 0.45rem 1.1rem;
  border-radius: 12px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.4);
  transition: transform 0.2s ease;
}

.logo-container:hover {
  transform: scale(1.03);
}

.hero-gradient-text {
  color: var(--text-primary);
}

/* Form Inputs & Selects Theme Adaptation */
input, select {
  background-color: var(--input-bg);
  color: var(--text-primary);
  border-color: var(--glass-border);
}

table thead tr {
  background-color: var(--table-header-bg) !important;
}
